# Copy this file to .env and fill in your values.
# Never commit your actual .env file.

# Your OpenAI API key (https://platform.openai.com/api-keys)
# Required by the Python (Chat Completions) and R pipelines.
OPENAI_API_KEY=sk-proj-...

# Your Anthropic API key (https://console.anthropic.com/settings/keys)
# Required by the Claude (Anthropic Messages API) pipeline.
ANTHROPIC_API_KEY=sk-ant-...

# Absolute path to the root TA folder that contains the lab-<N> subdirectory
# Windows example:  C:\Users\yourname\Desktop\University\TA
# macOS/Linux:      /home/yourname/university/TA
BASE_LAB_DIR=C:\Users\yourname\Desktop\University\TA

# ── Local LLM provider (optional) ────────────────────────────────────────────
# Uncomment all four lines below to route grading calls to a local LM Studio
# or Ollama server instead of the OpenAI API.  Leave commented to use OpenAI.
#
# 1. In LM Studio Developer tab, set: API=OpenAI-compatible, Enable Thinking=Off,
#    Context length=32768, Structured output=Off, Limit Response Length=Off.
# 2. Load a model and start the server.
# 3. Run: curl http://localhost:1234/v1/models   to get the exact API model id.
# 4. Paste that id as LLM_MODEL below (e.g. qwen/qwen3.6-27b).
#
# LLM_PROVIDER=local
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_MODEL=qwen/qwen3.6-27b
# LLM_API_KEY=lm-studio
